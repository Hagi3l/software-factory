# Build output
/bin/

# Test results (see the test-* convention in CLAUDE.md)
/test/results/

# Go build/test artifacts
*.test
*.out

# Runtime state written by `software-factory run` (embedded JetStream store, artifact store)
/.software-factory/

# Stray bare `go build ./cmd/software-factory` output (use make build -> /bin/).
# Both names: the binary is software-factory, but a pre-rename `harness` build may
# still be sitting in the tree.
/software-factory
/harness

# Local secret (OpenRouter key) — never commit
token.txt

# Stray demo run log (redirected stdout from demo/vault/run.sh)
/vault-demo.log

# Local Claude Code workflow worktrees (session-scoped, never committed)
/.claude/
