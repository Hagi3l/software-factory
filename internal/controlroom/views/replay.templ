package views

import (
	"strconv"

	"github.com/Loxstomper/harness/internal/controlroom/query"
)

// ReplayPage is the invocation replay view (specs/observability.md, "Replayability — the
// differentiator"; specs/control-room.md, T4.11): the reconstructed decision trail of one
// invocation — exactly what the LLM saw and did, turn by turn — parsed from the
// broker-captured transcript in the artifact store. It is the forensic answer to "why did
// the agent do that": when an autonomous change looks wrong, this is how a human answers it
// with certainty rather than guessing, and it is the audit mechanism that makes a
// no-human-review system accountable.
//
// Like the issue-detail page it drills from, it is a forensic snapshot, not a feed — plainly
// server-rendered with no SSE refresh. When no trail can be reconstructed (the transcript is
// not reachable, or could not be decoded) it renders a notice rather than failing, offering
// the raw-bytes link when a hash is known.
templ ReplayPage(rep query.Replay) {
	@Layout("Harness — Replay "+rep.Issue.ID, "") {
		<div class="mx-auto max-w-4xl space-y-6">
			<div class="space-y-2">
				<div class="flex flex-wrap items-center gap-3">
					<span class="font-mono text-sm text-muted">{ rep.Issue.ID }</span>
					@statusBadge(rep.Issue.Status)
					if rep.Merged {
						<span class="rounded bg-st-ok-bg px-1.5 py-0.5 text-xs text-st-ok">merged</span>
					}
				</div>
				<h1 class="text-2xl font-semibold tracking-tight">Replay — { orDash(rep.Issue.Title) }</h1>
				<div class="flex flex-wrap items-center gap-4 text-xs">
					<a href={ templ.URL("/issue/" + rep.Issue.ID) } class="text-st-progress hover:text-st-progress hover:underline">← Issue detail</a>
					if rep.Hash != "" {
						<a
							href={ templ.URL("/artifact/" + rep.Hash) }
							target="_blank"
							rel="noopener"
							class="font-mono text-muted hover:text-fg hover:underline"
						>raw transcript { shortHash(rep.Hash) }</a>
					}
				</div>
			</div>
			if !rep.Available {
				@replayNotice(rep)
			} else {
				if rep.System != "" {
					<section class="space-y-2">
						<h2 class="text-sm font-medium text-muted">System</h2>
						<pre class="whitespace-pre-wrap break-words rounded-lg border border-border bg-surface p-4 text-xs text-fg">{ rep.System }</pre>
					</section>
				}
				<section class="space-y-3">
					<div class="flex items-baseline justify-between">
						<h2 class="text-sm font-medium text-muted">Decision trail</h2>
						<span class="text-xs text-muted">
							{ strconv.Itoa(len(rep.Turns)) } turns · { strconv.Itoa(rep.TotalInput) } in · { strconv.Itoa(rep.TotalOutput) } out
							if rep.TotalCache > 0 {
								· { strconv.Itoa(rep.TotalCache) } cached
							}
						</span>
					</div>
					for _, t := range rep.Turns {
						@replayTurn(t)
					}
				</section>
			}
		</div>
	}
}

// replayNotice explains why there is no trail to render. A known hash that could not be
// loaded points the human at the raw bytes; no hash at all means none was retained — the
// transcript is stamped on an issue once an invocation completes (any disposition, merged or
// not), so the absence means this issue has not run yet, or no transcript was harvested.
templ replayNotice(rep query.Replay) {
	<div class="rounded-lg border border-border bg-surface p-6">
		if rep.Hash != "" {
			<p class="text-sm text-fg">The transcript for this invocation could not be loaded from the artifact store.</p>
			<p class="mt-1 text-xs text-muted">Its content address is <span class="font-mono">{ rep.Hash }</span> — try the raw-bytes link above.</p>
		} else {
			<p class="text-sm text-fg">No decision trail was captured for this invocation.</p>
			<p class="mt-1 text-xs text-muted">A transcript is stamped once an invocation completes; this issue has not run yet, or none was harvested.</p>
		}
	</div>
}

// replayTurn renders one llm-turn: its inbound context (what the model newly saw), the
// model's response, the tools it asked to call, and the turn's stop reason and token cost.
templ replayTurn(t query.ReplayTurn) {
	<article class="rounded-lg border border-border bg-surface">
		<header class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-4 py-2">
			<span class="text-sm font-medium text-fg">Turn { strconv.Itoa(t.Index) }</span>
			<div class="flex items-center gap-3 text-xs text-muted">
				@replayStopBadge(t.Stop)
				<span class="tabular-nums">{ strconv.Itoa(t.InputTokens) } in · { strconv.Itoa(t.OutputTokens) } out</span>
				if t.CacheRead > 0 {
					<span class="tabular-nums text-faint">{ strconv.Itoa(t.CacheRead) } cache read</span>
				}
				if t.CacheCreate > 0 {
					<span class="tabular-nums text-faint">{ strconv.Itoa(t.CacheCreate) } cache write</span>
				}
			</div>
		</header>
		<div class="space-y-3 p-4">
			for _, m := range t.Inbound {
				@replayInbound(m)
			}
			if t.Text != "" {
				<div class="space-y-1">
					<div class="text-xs font-medium uppercase tracking-wide text-st-ok">assistant</div>
					<pre class="whitespace-pre-wrap break-words rounded-md border border-border bg-canvas p-3 text-sm text-fg">{ t.Text }</pre>
				</div>
			}
			for _, tc := range t.ToolCalls {
				@replayToolCall(tc)
			}
		</div>
	</article>
}

// replayInbound renders one message the model saw at the start of a turn — the opening
// brief or a tool result fed back. A tool result that reported an error is tinted so a
// failure the model had to recover from reads at a glance.
templ replayInbound(m query.ReplayMessage) {
	<div class="space-y-1">
		<div class="text-xs font-medium uppercase tracking-wide text-muted">{ orDash(m.Role) }</div>
		if m.Text != "" {
			<pre class="whitespace-pre-wrap break-words rounded-md border border-border bg-canvas p-3 text-sm text-fg">{ m.Text }</pre>
		}
		for _, tr := range m.ToolResults {
			if tr.IsError {
				<pre class="whitespace-pre-wrap break-words rounded-md border border-st-blocked/30 bg-st-blocked-bg p-3 text-xs text-st-blocked">{ tr.Content }</pre>
			} else {
				<pre class="whitespace-pre-wrap break-words rounded-md border border-border bg-canvas p-3 text-xs text-muted">{ tr.Content }</pre>
			}
		}
	</div>
}

// replayToolCall renders one tool the model asked to invoke and the arguments it passed.
templ replayToolCall(tc query.ReplayToolCall) {
	<div class="space-y-1">
		<div class="flex items-center gap-2 text-xs">
			<span class="font-medium uppercase tracking-wide text-accent">tool call</span>
			<span class="font-mono text-fg">{ tc.Name }</span>
		</div>
		if tc.Args != "" {
			<pre class="overflow-x-auto whitespace-pre rounded-md border border-accent/30 bg-canvas p-3 text-xs text-accent-strong">{ tc.Args }</pre>
		}
	</div>
}

// replayStopBadge tints the turn's stop reason: tool_use (the loop continues) reads
// distinct from a natural end_turn, and a max_tokens truncation stands out as a budget
// signal. The class literals stay inline (a templ switch, not a Go helper) so the Tailwind
// scanner sees them, like statusBadge.
templ replayStopBadge(stop string) {
	switch stop {
		case "tool_use":
			<span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent">{ stop }</span>
		case "end_turn":
			<span class="rounded-full bg-st-ok-bg px-2 py-0.5 text-st-ok">{ stop }</span>
		case "max_tokens":
			<span class="rounded-full bg-st-warn-bg px-2 py-0.5 text-st-warn">{ stop }</span>
		case "":
			<span class="rounded-full bg-st-idle-bg px-2 py-0.5 text-muted">—</span>
		default:
			<span class="rounded-full bg-st-idle-bg px-2 py-0.5 text-fg">{ stop }</span>
	}
}

// ReplayNotAttached renders the replay chrome with a single notice instead of a trail —
// used when the control room is not attached to a running factory (a standalone `harness
// serve` has no stores to read) or when the issue cannot be loaded (an unknown id). It is the
// page-level fallback (a missing/undecodable transcript for a *known* issue is handled
// inline by ReplayPage's notice, which still shows the issue header).
templ ReplayNotAttached(msg string) {
	@Layout("Harness — Replay", "") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Replay</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
