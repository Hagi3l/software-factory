package views

import "github.com/Loxstomper/harness/internal/controlroom/live"

// ActivityPage renders the live activity feed inside the standard layout. The feed is
// "what the agents and the factory are doing right now" (specs/control-room.md, T4.5):
// agent rows — each streamed model turn (token/reasoning) coalesced into one rolling
// line, plus one row per tool call — and system rows teed from the factory's own log
// (dispatch, gating, merge, …), newest first, filterable by source. It refreshes over
// the T4.3 SSE substrate — an agent-event nudges an htmx refetch of just the list
// (throttled, since this is the live view), with a slow periodic backstop so a settled
// feed still converges when the event stream goes idle. The initial rows render inline
// so the page shows data before htmx attaches.
templ ActivityPage(entries []live.Entry) {
	@Layout("Harness — Activity", "activity") {
		// x-data lives on this outer wrapper, *outside* the htmx swap target (#activity), so
		// the chosen filter survives every live re-fetch. The rows inside carry x-show keyed
		// to this scope; Alpine re-applies them to swapped-in DOM.
		<div class="space-y-4" x-data="{ filter: 'all' }">
			<div class="flex items-baseline justify-between">
				<h1 class="text-xl font-semibold tracking-tight">Activity</h1>
				<span class="text-sm text-muted">live</span>
			</div>
			<div class="flex gap-1 text-xs">
				@activityFilterButton("all", "All")
				@activityFilterButton(live.SourceAgent, "Agents")
				@activityFilterButton(live.SourceSystem, "System")
			</div>
			<div hx-ext="sse" sse-connect="/events">
				<div
					id="activity"
					hx-get="/activity/items"
					hx-trigger="sse:agent-event throttle:1s, every 10s"
					hx-swap="innerHTML"
				>
					@ActivityList(entries)
				</div>
			</div>
		</div>
	}
}

// activityFilterButton is one All/Agents/System toggle. Clicking sets the shared filter;
// the active button is highlighted. Both bindings are Alpine expressions over the
// ActivityPage x-data scope.
templ activityFilterButton(value, label string) {
	<button
		type="button"
		class="rounded px-2 py-1 text-muted hover:bg-canvas hover:text-fg"
		x-on:click={ "filter = '" + value + "'" }
		x-bind:class={ "filter === '" + value + "' ? 'bg-st-idle-bg text-fg' : ''" }
	>{ label }</button>
}

// ActivityList renders just the feed rows. It is both embedded in ActivityPage for the
// initial paint and returned bare from GET /activity/items as the htmx swap target, so
// the live refresh replaces only the rows, never the chrome.
templ ActivityList(entries []live.Entry) {
	if len(entries) == 0 {
		<p class="text-sm text-muted">No activity yet.</p>
	} else {
		<ul class="flex flex-col gap-1">
			for _, e := range entries {
				@activityRow(e)
			}
		</ul>
	}
}

// activityRow renders one activity entry: time, kind badge, source id (agent invocation
// or system component), and detail. x-show hides the row unless the active filter is
// "all" or matches the row's source, so the toggle narrows agent vs system without a
// server round-trip. A faint accent on system rows distinguishes the two streams at a
// glance even when both are shown.
templ activityRow(e live.Entry) {
	<li
		class={ "flex items-start gap-3 rounded-md border px-3 py-2", activityRowAccent(e.Source), subContextNest(e.SubContext) }
		x-show={ "filter === 'all' || filter === '" + e.Source + "'" }
	>
		<span class="shrink-0 font-mono text-xs tabular-nums text-muted">{ activityTime(e.At) }</span>
		@activityBadge(e.Kind)
		if e.SubContext != "" {
			@subContextBadge(e.SubContext)
		}
		if e.IssueID != "" {
			// An agent row drills into the live invocation view scoped to this issue (T4.21,
			// control-room.md "drill from … an activity-feed row"). The issue id rides on the
			// event envelope (T4.20), so no beads read is needed to build the link.
			<a href={ templ.URL("/invocation/" + e.IssueID) } class="shrink-0 font-mono text-xs text-st-progress hover:text-st-progress hover:underline">{ e.AgentID }</a>
		} else {
			<span class="shrink-0 font-mono text-xs text-muted">{ e.AgentID }</span>
		}
		<span class="whitespace-pre-wrap break-all text-sm text-fg">{ e.Detail }</span>
	</li>
}

// activityRowAccent tints the row container by source so the factory's system stream is
// distinguishable from agent output even with the filter on "all".
func activityRowAccent(source string) string {
	if source == live.SourceSystem {
		return "border-border-strong bg-canvas"
	}
	return "border-border bg-surface"
}

// subContextNest indents and left-borders a row emitted by a sub-context (the explore tool's
// nested read-only sub-loop) so the explorer's reasoning/tokens read as nested UNDER the
// parent invocation rather than as separate parent turns (specs/observability.md live
// nesting). Empty for a parent-soul row, which then renders exactly as before. The literals
// are inline in a Go helper (like activityRowAccent) so the Tailwind scanner, which globs
// *_templ.go, sees the classes.
func subContextNest(subContext string) string {
	if subContext == "" {
		return ""
	}
	return "ml-6 border-l-2 border-st-progress"
}

// subContextBadge marks which pinned model produced a nested row (e.g. "explorer"), so the
// nesting is carried by text too, not color alone. Kept as a templ switch-free span with an
// inline class literal for the same Tailwind-scanner reason as activityBadge.
templ subContextBadge(subContext string) {
	<span class="shrink-0 rounded-full bg-st-progress-bg px-2 py-0.5 text-xs text-st-progress">{ subContext }</span>
}

// activityBadge tints an event kind so the feed reads at a glance: agent channels
// (token/reasoning/tool) and system log levels (info/warn/error) each get a color. The
// class literals are kept inline (a templ switch, not a Go helper) so the Tailwind
// scanner — which globs *.templ / *_templ.go — actually sees them, the same reason
// board.go's statusBadge is a switch.
templ activityBadge(kind string) {
	switch kind {
		case "token":
			<span class="shrink-0 rounded-full bg-accent-soft px-2 py-0.5 text-xs text-accent">{ kind }</span>
		case "reasoning":
			<span class="shrink-0 rounded-full bg-st-progress-bg px-2 py-0.5 text-xs text-st-progress">{ kind }</span>
		case "tool":
			<span class="shrink-0 rounded-full bg-st-ok-bg px-2 py-0.5 text-xs text-st-ok">{ kind }</span>
		case "progress":
			<span class="shrink-0 rounded-full bg-st-warn-bg px-2 py-0.5 text-xs text-st-warn">{ kind }</span>
		case "log", "info":
			<span class="shrink-0 rounded-full bg-st-progress-bg px-2 py-0.5 text-xs text-st-progress">{ kind }</span>
		case "warn":
			<span class="shrink-0 rounded-full bg-st-warn-bg px-2 py-0.5 text-xs text-st-warn">{ kind }</span>
		case "error":
			<span class="shrink-0 rounded-full bg-red-500/20 px-2 py-0.5 text-xs text-red-300">{ kind }</span>
		default:
			<span class="shrink-0 rounded-full bg-st-idle-bg px-2 py-0.5 text-xs text-fg">{ kind }</span>
	}
}

// ActivityMessage renders the activity chrome with a single notice instead of the feed —
// used when the control room is not attached to a running factory (a standalone `harness
// serve` has no NATS to tail, so there is no live source).
templ ActivityMessage(msg string) {
	@Layout("Harness — Activity", "activity") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Activity</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
