package views

import (
	"strconv"

	"github.com/Loxstomper/software-factory/internal/controlroom/query"
	"github.com/Loxstomper/software-factory/internal/core"
)

// VerificationPage is the verification view (specs/control-room.md "The verification view",
// T4.23): the factory's trust argument for one issue, made legible. Verification is how the
// factory merges with no human reading code — yet its proof was historically computed by the
// gate and discarded, leaving only a green checkmark. This page reconstructs the whole
// argument forensically from the persisted gate-verdict record (T4.22): the producer≠verifier
// soul split, the red→green proof per check, the mutation score against its threshold, the
// scanners, and the test↔spec traceability map.
//
// It is a forensic snapshot (a settled proof, like Replay), not a feed, so it is plainly
// server-rendered with no SSE refresh. It renders for *rejected* candidates too — a failed
// verdict is exactly what a human triaging the dead-letter queue needs to see — and degrades
// to a notice (offering the raw-bytes link when a hash is known) rather than failing the page.
// Artifact bytes it links (raw gate output) are served untrusted per security.md Control 7.
templ VerificationPage(v query.GateVerdictView) {
	@Layout("Harness — Verification "+v.Issue.ID, "") {
		<div class="mx-auto max-w-4xl space-y-6">
			<div class="space-y-2">
				<div class="flex flex-wrap items-center gap-3">
					<span class="font-mono text-sm text-muted">{ v.Issue.ID }</span>
					@statusBadge(v.Issue.Status)
					if v.Merged {
						<span class="rounded bg-st-ok-bg px-1.5 py-0.5 text-xs text-st-ok">merged</span>
					}
					if v.Available {
						@verdictBadge(v.Verdict.Passed)
					}
				</div>
				<h1 class="text-2xl font-semibold tracking-tight">Verification — { orDash(v.Issue.Title) }</h1>
				<div class="flex flex-wrap items-center gap-4 text-xs">
					<a href={ templ.URL("/issue/" + v.Issue.ID) } class="text-st-progress hover:text-st-progress hover:underline">← Issue detail</a>
					if v.Hash != "" {
						<a
							href={ templ.URL("/artifact/" + v.Hash) }
							target="_blank"
							rel="noopener"
							class="font-mono text-muted hover:text-fg hover:underline"
						>raw verdict { shortHash(v.Hash) }</a>
					}
				</div>
			</div>
			// Producer ≠ verifier. The two producing souls are read from the issue's own
			// stamps, so this renders even for a rejected candidate with no merge trailer. The
			// qa gate has no verifier soul — it runs in the orchestrator-controlled clean
			// verification sandbox, and that structural independence (not a third agent) IS the
			// verification. Saying so explicitly is the point of the view.
			<section class="space-y-3">
				<h2 class="text-sm font-medium text-muted">Producer ≠ verifier</h2>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
					@soulCard("Test author", "authored the acceptance tests", v.TestsSoul)
					@soulCard("Implementor", "implemented against them", v.ImplementSoul)
				</div>
				<p class="text-xs text-muted">
					The <span class="font-mono text-muted">qa</span> gate has no verifier soul: it runs independently in the orchestrator-controlled clean verification sandbox. That structural separation — not a third agent — is the verification.
				</p>
			</section>
			// The test↔spec traceability map: the only window into how the author read the prose.
			<section class="space-y-2">
				<h2 class="text-sm font-medium text-muted">Traceability</h2>
				<ul class="flex flex-col gap-2">
					@evidenceItem(v.Trace)
				</ul>
			</section>
			// The transformation log (T6.3): which of this candidate's writes were precise
			// (semantic, language-server WorkspaceEdits) and which fell back to the text floor — an
			// imprecise rename can rewrite comments/string literals, so a text fallback warrants a
			// closer look. Shown only when the issue ran a semantic write tool (a hash is stamped).
			if v.TransformLog.Hash != "" {
				<section class="space-y-3">
					<div class="flex items-baseline justify-between">
						<h2 class="text-sm font-medium text-muted">Transformations</h2>
						if v.TransformLog.Available {
							<span class="text-xs text-muted">
								{ strconv.Itoa(len(v.Transforms)) } applied
								if n := transformFallbackCount(v.Transforms); n > 0 {
									· <span class="text-st-warn">{ strconv.Itoa(n) } via text fallback</span>
								}
							</span>
						}
					</div>
					if v.TransformLog.Available && len(v.Transforms) > 0 {
						<ul class="flex flex-col gap-2">
							for _, tr := range v.Transforms {
								@transformRow(tr)
							}
						</ul>
					} else if v.TransformLog.Available {
						<p class="text-sm text-muted">The transformation log recorded no entries.</p>
					} else {
						<p class="text-sm text-muted">The transformation log could not be loaded from the artifact store — try the raw-bytes link.</p>
					}
					<ul class="flex flex-col gap-2">
						@evidenceItem(v.TransformLog)
					</ul>
				</section>
			}
			if !v.Available {
				@verdictNotice(v)
			} else {
				<section class="space-y-3">
					<div class="flex items-baseline justify-between">
						<h2 class="text-sm font-medium text-muted">Gate verdict</h2>
						<span class="text-xs text-muted">{ strconv.Itoa(len(v.Verdict.Checks)) } checks</span>
					</div>
					if len(v.Verdict.Checks) == 0 {
						<p class="text-sm text-muted">The gate run recorded no individual checks.</p>
					} else {
						<ul class="flex flex-col gap-2">
							for _, c := range v.Verdict.Checks {
								@verdictCheck(c)
							}
						</ul>
					}
				</section>
			}
		</div>
	}
}

// soulCard names one producing soul. An unstamped soul (the stage has not run in this
// issue's lineage yet) reads as "not recorded" rather than a blank, so the card is never an
// empty box that looks like a render bug.
templ soulCard(role, did, soul string) {
	<div class="rounded-lg border border-border bg-surface p-4">
		<div class="text-xs uppercase tracking-wide text-muted">{ role }</div>
		if soul != "" {
			<div class="mt-1 font-mono text-sm text-fg">{ soul }</div>
		} else {
			<div class="mt-1 text-sm text-faint">not recorded</div>
		}
		<div class="mt-1 text-xs text-muted">{ did }</div>
	</div>
}

// verdictCheck renders one gate check: its kind, pass/fail, and the kind-specific detail —
// the red→green base/candidate exit pair, or the metric score against its threshold — each
// with a link to its own captured-output evidence (untrusted raw bytes via /artifact). A
// check cited with no persisted evidence still shows: that it ran is itself signal.
templ verdictCheck(c core.GateCheckOutcome) {
	<li class="space-y-2 rounded-md border border-border bg-surface px-3 py-2.5 text-sm">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				@checkStatusBadge(c)
				<span class="text-fg">{ orDash(c.Name) }</span>
				<span class="rounded-full bg-canvas px-2 py-0.5 text-xs text-muted">{ checkKindLabel(c.Kind) }</span>
			</div>
			if c.Evidence != "" {
				<a
					href={ templ.URL("/artifact/" + c.Evidence) }
					target="_blank"
					rel="noopener"
					class="font-mono text-xs text-st-progress hover:text-st-progress hover:underline"
				>{ shortHash(c.Evidence) }</a>
			} else {
				<span class="text-xs text-faint">no evidence persisted</span>
			}
		</div>
		if c.Base != nil {
			// A red→green proof: the acceptance tests must FAIL on the pre-implementation base
			// (a non-zero exit is the red half) and PASS on the candidate (the check's own exit).
			<div class="flex flex-wrap items-center gap-3 text-xs text-muted">
				<span>base exit { strconv.Itoa(c.Base.ExitCode) }</span>
				if c.Base.ExitCode != 0 {
					<span class="text-st-blocked">red ✓</span>
				} else {
					<span class="text-st-warn">base did not fail</span>
				}
				<span class="text-faint">→</span>
				<span>candidate exit { strconv.Itoa(c.ExitCode) }</span>
				if c.ExitCode == 0 {
					<span class="text-st-ok">green ✓</span>
				} else {
					<span class="text-st-blocked">candidate failed</span>
				}
			</div>
		} else if c.Metric != nil {
			<div class="text-xs text-muted">
				<span class="font-mono">{ metricSummary(c.Metric) }</span>
			</div>
		} else if c.ExitCode != 0 {
			<div class="text-xs text-muted">exit { strconv.Itoa(c.ExitCode) }</div>
		}
		if len(c.Findings) > 0 {
			// The structured findings the gate's per-tool adapter parsed from this check's raw
			// output — the compact, signal-dense form (the raw dump stays the linked evidence).
			// Rendered as the same cache-stable Findings.Format() a failed candidate's retry Brief
			// carries, so the human and the agent read one representation (T9.5).
			<div class="space-y-1">
				<div class="text-xs text-muted">{ strconv.Itoa(len(c.Findings)) } findings</div>
				<pre class="overflow-x-auto whitespace-pre-wrap rounded bg-canvas p-2 text-xs text-fg">{ c.Findings.Format() }</pre>
			</div>
		}
	</li>
}

// verdictBadge tints the overall gate disposition (the assembled record's Passed). The class
// literals stay inline (a templ switch, not a Go helper) so the Tailwind scanner sees them.
templ verdictBadge(passed bool) {
	if passed {
		<span class="rounded-full bg-st-ok-bg px-2 py-0.5 text-xs text-st-ok">gate passed</span>
	} else {
		<span class="rounded-full bg-st-blocked-bg px-2 py-0.5 text-xs text-st-blocked">gate failed</span>
	}
}

// checkStatusBadge tints one check's tri-state outcome (passed / failed / not-run). not-run
// is its own state — a check the build precondition short-circuited because nothing can run
// on a tree that does not compile (T9.4); rendering it as a plain "fail" would lie about
// whether the gate actually checked it. A record predating the tri-state (empty Status) falls
// back to the two-valued Passed badge so old verdicts still render. The class literals stay
// inline (a templ switch, not a Go helper) so the Tailwind scanner sees them.
templ checkStatusBadge(c core.GateCheckOutcome) {
	switch c.Status {
		case core.CheckStatusNotRun:
			<span class="rounded-full bg-st-warn-bg px-2 py-0.5 text-xs text-st-warn">not-run</span>
		case core.CheckStatusFailed:
			<span class="rounded-full bg-st-blocked-bg px-2 py-0.5 text-xs text-st-blocked">fail</span>
		case core.CheckStatusPassed:
			<span class="rounded-full bg-st-ok-bg px-2 py-0.5 text-xs text-st-ok">pass</span>
		default:
			@checkPassBadge(c.Passed)
	}
}

// checkPassBadge tints one check's pass/fail — the back-compat path for a verdict recorded
// before the tri-state Status existed.
templ checkPassBadge(passed bool) {
	if passed {
		<span class="rounded-full bg-st-ok-bg px-2 py-0.5 text-xs text-st-ok">pass</span>
	} else {
		<span class="rounded-full bg-st-blocked-bg px-2 py-0.5 text-xs text-st-blocked">fail</span>
	}
}

// verdictNotice explains why there is no assembled verdict to render. A known hash that could
// not be loaded points the human at the raw bytes; no hash at all means the candidate has not
// been gated yet (or the gate could not persist a record) — self-describing, never blank.
templ verdictNotice(v query.GateVerdictView) {
	<div class="rounded-lg border border-border bg-surface p-6">
		if v.Hash != "" {
			<p class="text-sm text-fg">The gate-verdict record for this issue could not be loaded from the artifact store.</p>
			<p class="mt-1 text-xs text-muted">Its content address is <span class="font-mono">{ v.Hash }</span> — try the raw-bytes link above.</p>
		} else {
			<p class="text-sm text-fg">No gate verdict has been recorded for this issue yet.</p>
			<p class="mt-1 text-xs text-muted">A verdict is harvested for every gate run, pass or fail; this issue's candidate has not been gated.</p>
		}
	</div>
}

// transformRow renders one transformation (T6.3): its mechanism (semantic vs text fallback), the
// tool, what it acted on, the blast radius (files/edits), and — for a text fallback — the precision
// note the tool emitted (e.g. "N match(es); M inside comments"). A text-fallback row reads as a
// caution at a glance, which is the whole point: the gate and a human weigh it more suspiciously
// than a server-precise one.
templ transformRow(t core.TransformRecord) {
	<li class="space-y-1.5 rounded-md border border-border bg-surface px-3 py-2.5 text-sm">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				@transformMechanismBadge(t.Mechanism)
				<span class="font-mono text-fg">{ orDash(t.Tool) }</span>
			</div>
			<span class="text-xs text-muted">{ transformBlast(t) }</span>
		</div>
		if t.Target != "" {
			<div class="font-mono text-xs break-words text-muted">{ t.Target }</div>
		}
		if t.Note != "" {
			<div class="text-xs text-st-warn">{ t.Note }</div>
		}
	</li>
}

// transformMechanismBadge tints a transformation's mechanism: semantic (the language server's own
// WorkspaceEdit — precise) reads ok, text (the degraded word-boundary floor — can corrupt comments
// and string literals) reads warn. The cases reference the core constants so the badge and the
// producer agree on the vocabulary; the class literals stay inline so the Tailwind scanner sees them.
templ transformMechanismBadge(mech string) {
	switch mech {
		case core.TransformMechanismSemantic:
			<span class="rounded-full bg-st-ok-bg px-2 py-0.5 text-xs text-st-ok">semantic</span>
		case core.TransformMechanismText:
			<span class="rounded-full bg-st-warn-bg px-2 py-0.5 text-xs text-st-warn">text fallback</span>
		default:
			<span class="rounded-full bg-canvas px-2 py-0.5 text-xs text-muted">{ orDash(mech) }</span>
	}
}

// VerificationNotAttached renders the verification chrome with a single notice instead of a
// verdict — used when the control room is not attached to a running factory (a standalone
// `software-factory serve` has no stores to read) or when the issue cannot be loaded (an unknown id).
// A missing/undecodable verdict for a *known* issue is handled inline by VerificationPage's
// notice, which still shows the issue header and the soul split.
templ VerificationNotAttached(msg string) {
	@Layout("Harness — Verification", "") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Verification</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
