package views

import (
	"strconv"

	"github.com/Loxstomper/software-factory/internal/controlroom/query"
)

// DeadLetterPage is the dead-letter queue (specs/control-room.md, T4.8): the escalations
// awaiting a human — work the factory dead-lettered on a budget breach, an exhausted retry
// cap, or an escalation it cannot resolve (specs/workflow.md). It is the control room's
// primary *action* surface: per the human re-entry invariant, stuck work is resolved by
// refining the governing spec (never by editing code — specs/specs-process.md), so each
// entry's title links into the issue-detail page (T4.7) for the forensic trail and a prominent
// "Resolve →" link launches the Resolve wizard (T4.15) — the action — pre-loaded from the
// escalation. The orchestrator's dead-letter reason is now shown inline too (T4.15).
//
// Like the board and the feed it is live over the T4.3 SSE substrate: the typed issue-state
// event (T4.16/T4.17) nudges an htmx refetch of just the list (throttled) — a dead-letter is
// itself a transition, so the queue surfaces a newly-blocked issue the moment it lands — with
// a slow periodic backstop so the queue still converges when the event stream is idle. The
// initial list renders inline so the page shows data before htmx attaches.
templ DeadLetterPage(items []query.DeadLetter) {
	@Layout("Harness — Dead-letter", "dlq") {
		<div class="space-y-4">
			<div class="flex items-baseline justify-between">
				<h1 class="text-xl font-semibold tracking-tight">Dead-letter queue</h1>
				<span class="text-sm text-muted">{ strconv.Itoa(len(items)) } awaiting a human</span>
			</div>
			<p class="max-w-3xl text-sm text-muted">
				Work the factory dead-lettered — budget or retries exhausted, or an escalation it could not resolve. A human triages each by refining the governing spec, never by editing code.
			</p>
			<div hx-ext="sse" sse-connect="/events">
				<div
					id="dlq"
					hx-get="/dlq/items"
					hx-trigger="sse:issue-state throttle:2s, every 15s"
					hx-swap="innerHTML"
				>
					@DeadLetterList(items)
				</div>
			</div>
		</div>
	}
}

// DeadLetterList renders just the queue entries. It is both embedded in DeadLetterPage for
// the initial paint and returned bare from GET /dlq/items as the htmx swap target, so the
// live refresh replaces only the list, never the chrome. An empty queue is the *good*
// state — nothing needs a human — so it reads as reassurance, not an error.
templ DeadLetterList(items []query.DeadLetter) {
	if len(items) == 0 {
		<div class="rounded-lg border border-border bg-surface p-6 text-center">
			<p class="text-sm text-fg">Nothing needs a human.</p>
			<p class="mt-1 text-xs text-muted">No work has dead-lettered — the queue is empty.</p>
		</div>
	} else {
		<ul class="flex flex-col gap-2">
			for _, dl := range items {
				@deadLetterRow(dl)
			}
		</ul>
	}
}

// deadLetterRow is one escalation, tinted rose to read as "needs attention" the moment the eye
// lands on it. The title links to the issue/invocation detail view (T4.7) for the full forensic
// trail; the prominent "Resolve →" link launches the Resolve wizard (T4.15) — the *action* per
// the human re-entry invariant (refine the spec, never edit code). The reason is the
// orchestrator's own classification of why the work terminated (T4.15), shown so the human sees
// the cause without drilling in; the spend and attempt sit alongside since a budget breach and an
// exhausted retry cap are the two non-escalation causes (specs/workflow.md). The row is no longer
// a single anchor — it carries two distinct links — so it is a card, not a click-through.
templ deadLetterRow(dl query.DeadLetter) {
	<li class="rounded-md border border-st-blocked/30 bg-st-blocked-bg p-3">
		<div class="flex items-center justify-between gap-2">
			<span class="font-mono text-xs text-muted">{ dl.ID }</span>
			<div class="flex items-center gap-3">
				<span class="rounded bg-st-blocked-bg px-1.5 py-0.5 text-xs text-st-blocked">blocked</span>
				// The verification view is forensic and renders for rejected candidates too (T4.23),
				// so it is the first place a triager looks: what did the gate actually find? It
				// degrades to the producer≠verifier soul split plus a notice when the issue
				// dead-lettered before its candidate was ever gated.
				<a href={ templ.URL("/verification/" + dl.ID) } class="text-xs text-st-progress hover:text-st-progress hover:underline">Verification</a>
				<a href={ templ.URL("/resolve/" + dl.ID) } class="rounded bg-st-ok px-2 py-0.5 text-xs font-medium text-white transition hover:bg-st-ok">Resolve →</a>
			</div>
		</div>
		<p class="mt-1 text-sm">
			<a href={ templ.URL("/issue/" + dl.ID) } class="text-fg hover:text-fg hover:underline">{ dl.Title }</a>
		</p>
		if dl.Reason != "" {
			<p class="mt-1 text-xs text-st-blocked">{ dl.Reason }</p>
		}
		<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
			if dl.Role != "" {
				<span>{ dl.Role }</span>
			}
			if dl.Spec != "" {
				<span class="font-mono text-muted">{ dl.Spec }</span>
			}
			<span class="text-st-warn">attempt { strconv.Itoa(dl.Attempt) }</span>
			<span>{ strconv.Itoa(dl.SpentTokens) } tokens · { formatUSD(dl.SpentUSD) }</span>
		</div>
	</li>
}

// DeadLetterMessage renders the DLQ chrome with a single notice instead of the queue —
// used when the control room is not attached to a running factory (a standalone `harness
// serve` has no beads to read) or when the queue read fails.
templ DeadLetterMessage(msg string) {
	@Layout("Harness — Dead-letter", "dlq") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Dead-letter queue</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
