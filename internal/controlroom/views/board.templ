package views

import (
	"strconv"

	"github.com/Loxstomper/harness/internal/controlroom/query"
)

// BoardPage is the kanban view (specs/control-room.md, T4.4): every beads issue grouped
// into a column by the role/stage it is dispatched to, columns left-to-right in pipeline
// order. It is server-rendered (templ) and made live without a client graph lib: the SSE
// substrate (T4.3) wraps the columns, and the typed `sse:issue-state` trigger (T4.16/T4.17)
// re-fetches the columns fragment (throttled) exactly when the orchestrator advances work,
// with a slow periodic backstop so a settled board still converges when the event stream is
// idle. The swap opts into the browser's View Transitions API (`transition:true`) so a card
// that lands in a new column *animates* its move (each card carries a stable
// view-transition-name; T4.18); the initial columns are rendered inline so the page shows
// data immediately, before htmx attaches. The ticker.js script powers the per-card timers.
templ BoardPage(board query.Board) {
	@Layout("Harness — Board", "board") {
		<script src="/static/ticker.js" defer></script>
		<script src="/static/board-autoscroll.js" defer></script>
		<div class="space-y-4">
			<div class="flex items-baseline justify-between">
				<h1 class="text-xl font-semibold tracking-tight">Board</h1>
				<div class="flex items-center gap-3">
					<button
						id="board-autoscroll-toggle"
						type="button"
						aria-pressed="true"
						title="Auto-scroll the board to where the work is"
						class="inline-flex items-center gap-1.5 rounded-full border border-border px-2.5 py-1 text-xs font-medium text-muted transition hover:border-border-strong hover:text-fg aria-pressed:border-st-progress aria-pressed:bg-st-progress-bg aria-pressed:text-st-progress"
					>
						<span aria-hidden="true">⇄</span>auto-scroll
					</button>
					<span class="text-sm text-muted">{ strconv.Itoa(board.Total) } issues</span>
				</div>
			</div>
			<div hx-ext="sse" sse-connect="/events">
				<div
					id="board"
					hx-get="/board/cards"
					hx-trigger="sse:issue-state throttle:2s, every 15s"
					hx-swap="innerHTML transition:true"
				>
					@BoardColumns(board)
				</div>
			</div>
		</div>
	}
}

// BoardColumns renders just the kanban columns. It is both embedded in BoardPage for the
// initial paint and returned bare from GET /board/cards as the htmx swap target, so the
// live refresh replaces only the columns, never the chrome.
templ BoardColumns(board query.Board) {
	if len(board.Columns) == 0 {
		<p class="text-muted">No issues yet.</p>
	} else {
		<div class="flex gap-4 overflow-x-auto pb-4">
			for _, col := range board.Columns {
				@boardColumn(col)
			}
		</div>
	}
}

// boardColumn is one stage's column: a header naming the stage with a live count, then
// its cards (ordered by the query layer for a stable render).
templ boardColumn(col query.BoardColumn) {
	<div
		if col.Focus {
			data-board-focus
		}
		class="flex w-72 shrink-0 flex-col rounded-xl border border-border bg-surface shadow-card"
	>
		<div class="flex items-center justify-between border-b border-border px-3 py-2.5">
			<span class="text-sm font-semibold text-fg">{ col.Stage }</span>
			<span class="rounded-full bg-canvas px-2 py-0.5 text-xs font-medium text-muted">{ strconv.Itoa(len(col.Cards)) }</span>
		</div>
		<div class="flex flex-col gap-2 p-2">
			for _, card := range col.Cards {
				@boardCard(card)
			}
		</div>
	</div>
}

// boardCard is the compact issue projection. The whole card is the click-through into the
// live invocation view (T4.21) — "drill from a board card (the agent currently working it)"
// (control-room.md): the board's role is triage, the invocation view is where a human watches
// that worker think (and, once it terminates, hands off to the forensic issue/Replay drill it
// links onward to). It carries a stable id + view-transition-name keyed on the issue id (T4.18)
// so the View Transitions API can tween the card to a new column on a live refresh, and a
// per-card timer line ticked client-side.
templ boardCard(card query.IssueCard) {
	<a
		id={ "card-" + card.ID }
		href={ templ.URL("/invocation/" + card.ID) }
		style={ cardVTName(card.ID) }
		class="block rounded-lg border border-border bg-raised p-3 shadow-card transition duration-150 hover:-translate-y-0.5 hover:border-border-strong hover:shadow-card-hover"
	>
		<div class="flex items-center justify-between gap-2">
			<span class="font-mono text-xs text-faint">{ card.ID }</span>
			@statusBadge(card.Status)
		</div>
		<p class="mt-1.5 text-sm text-fg">{ card.Title }</p>
		if card.Spec != "" {
			<p class="mt-1 truncate font-mono text-xs text-faint">{ card.Spec }</p>
		}
		if card.Attempt > 1 {
			<p class="mt-1 text-xs text-st-warn">attempt { strconv.Itoa(card.Attempt) }</p>
		}
		@cardTimer(card)
	</a>
}

// cardTimer is the card's clock line (T4.18, control-room.md "The board, in motion"). For an
// open/in-progress/blocked card it is *live*: time in the current state (label keyed off status
// server-side) and total time since the issue was created. The server emits two epoch anchors —
// data-state-since (StateEnteredAt) and data-created (CreatedAt) — and never re-renders to tick;
// the Alpine ticker (x-data="cardTicker()", ticker.js) rewrites the two x-ref spans every second
// in the browser. An empty anchor (unstamped/absent) renders a dash. The current-state timer
// resets naturally on the next transition, since the refetched card carries a fresh anchor.
//
// A closed card has no live clock — the work is done, so a ticking counter would only inflate
// meaninglessly. Instead it shows a single static lead time ("took 2h05m" = StateEnteredAt −
// CreatedAt), rendered server-side with no ticker. Blocked cards stay live by design: their
// time-in-state is the "how long has this been awaiting triage" signal.
templ cardTimer(card query.IssueCard) {
	if card.Status == "closed" {
		<div class="mt-2 flex items-center justify-between text-xs text-faint">
			<span>took <span class="tabular-nums text-muted">{ orDash(leadTime(card)) }</span></span>
		</div>
	} else {
		<div
			class="mt-2 flex items-center justify-between text-xs text-faint"
			data-state-since={ epochAttr(card.StateEnteredAt) }
			data-created={ epochAttr(card.CreatedAt) }
			x-data="cardTicker()"
		>
			<span>{ stateLabel(card.Status) } <span x-ref="state" class="tabular-nums text-muted">—</span></span>
			<span class="tabular-nums" x-ref="total">—</span>
		</div>
	}
}

// statusBadge tints the beads status so the board reads at a glance — blocked work (the
// dead-letter action surface) stands out, closed/merged work recedes. The class literals
// are kept inline (not a Go helper) so the Tailwind scanner, which globs *.templ /
// *_templ.go, actually sees them.
templ statusBadge(status string) {
	switch status {
		case "blocked":
			<span class="inline-flex items-center gap-1 rounded-full bg-st-blocked-bg px-2 py-0.5 text-xs font-medium text-st-blocked"><span class="h-1.5 w-1.5 rounded-full bg-st-blocked"></span>{ status }</span>
		case "in_progress":
			<span class="inline-flex items-center gap-1 rounded-full bg-st-progress-bg px-2 py-0.5 text-xs font-medium text-st-progress"><span class="h-1.5 w-1.5 rounded-full bg-st-progress"></span>{ status }</span>
		case "closed":
			<span class="inline-flex items-center gap-1 rounded-full bg-st-idle-bg px-2 py-0.5 text-xs font-medium text-st-idle"><span class="h-1.5 w-1.5 rounded-full bg-st-idle"></span>{ status }</span>
		default:
			<span class="inline-flex items-center gap-1 rounded-full bg-st-idle-bg px-2 py-0.5 text-xs font-medium text-st-idle"><span class="h-1.5 w-1.5 rounded-full bg-st-idle"></span>{ status }</span>
	}
}

// BoardMessage renders the board chrome with a single notice instead of columns — used
// when the control room is not attached to a running factory (a standalone `harness
// serve` has no beads to read) or when the board read fails.
templ BoardMessage(msg string) {
	@Layout("Harness — Board", "board") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Board</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
