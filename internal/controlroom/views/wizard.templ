package views

import (
	"fmt"

	"github.com/Loxstomper/harness/internal/controlroom/wizard"
)

// CreatePage is the Create-Task wizard (specs/control-room.md "The wizard"): a steered
// conversation with the trusted, non-sandboxed requirements planner that converges on
// testable intent. It is the human's primary action surface — the one place intent is
// authored before autonomous work is seeded.
//
// It is server-rendered and made live with the same SSE substrate the other views use, but
// in a richer two-channel form because this *is* a streaming conversation: the transcript
// container re-fetches the finalized messages on a `turn` nudge (the server-render-a-fragment
// pattern), while the planner's reply streams token-by-token into a live target via `delta`
// events as it is generated. Both bindings sit inside one SSE-connected element scoped to
// this session, so one human's stream never reaches another.
//
// The wizard is the full Create-Task flow: the conversation loop (T4.12), the live alignment
// ledger (T4.13), and the draft + APPROVE consent gate (T4.14). The draft panel shows the spec
// markdown and seed issues the planner proposes; APPROVE is the consent boundary — only then is
// the spec committed to git, the decisions sidecar written, the transcript stored, and the seed
// issues created through the single-writer path. Everything past APPROVE is autonomous.
// prefill is the optional prepared requirement (requirements_planner.prefill): non-empty, the
// composer offers a button that inserts it for the operator to review and send. Empty renders
// the composer unchanged.
templ CreatePage(sessionID, prefill string, msgs []wizard.Message) {
	@Layout("Harness — Create Task", "create") {
		<script src="/static/wizard.js" defer></script>
		<div class="mx-auto flex max-w-3xl flex-col gap-4">
			<div>
				<h1 class="text-xl font-semibold tracking-tight">Create Task</h1>
				<p class="mt-1 text-sm text-muted">
					A steered conversation with the requirements planner. Describe what you want
					built; it will probe for examples, edge cases, what to reject, and what is out
					of scope — converging on testable intent. Nothing is written until you approve.
				</p>
			</div>
			<div hx-ext="sse" sse-connect={ "/create/stream/" + sessionID } class="flex flex-col gap-3">
				<div
					id="wizard-ledger"
					hx-get={ "/create/ledger/" + sessionID }
					hx-trigger="sse:ledger, htmx:sseOpen from:closest [hx-ext='sse']"
					hx-swap="innerHTML"
				>
					@LedgerPanel(sessionID, nil)
				</div>
				<div
					id="wizard-draft"
					hx-get={ "/create/draft/" + sessionID }
					hx-trigger="sse:draft, htmx:sseOpen from:closest [hx-ext='sse']"
					hx-swap="innerHTML"
				>
					@DraftPanel(sessionID, wizard.Draft{}, nil, true)
				</div>
				<div id="wizard-result"></div>
				@wizardConversation(sessionID, "Describe the change you want, or answer the planner's question…", prefill, msgs)
			</div>
		</div>
	}
}

// wizardConversation is the shared transcript + composer for both wizard entry modes — Create
// (CreatePage) and Resolve (ResolvePage), which are "the same wizard, two entry modes"
// (specs/control-room.md "Create and Resolve are the same component"). Extracting it keeps the
// chat ergonomics single-source so the two pages cannot drift.
//
// The transcript is a fixed-height scroll viewport (`h-[55vh] overflow-y-auto`): new turns scroll
// it rather than growing the page, so the composer stays put. The wizardChat() Alpine component
// (wizard.js) pins it to the latest turn as the reply streams — unless the human has scrolled up
// to read history. The composer has no visible Send button: plain Enter sends (Shift+Enter inserts
// a newline), with an sr-only submit kept for accessibility and as requestSubmit's submitter, and
// a one-line keyboard hint. After a send the textarea is reset and refocused for the next turn.
// placeholder differs per mode (eliciting new intent vs. clarifying a spec).
//
// prefill, when non-empty, adds one button beside the keyboard hint that inserts the prepared
// requirement into the textarea (wizardChat().insertPrefill — it only fills the composer; the
// operator still reviews and sends, so the send stays a deliberate human act). The text rides a
// data attribute: templ escapes it as an inert value and the browser unescapes on read, so the
// inserted content is byte-identical to the configured file. Create passes it through from
// requirements_planner.prefill; Resolve passes "" (a dead-letter conversation has no canned
// opening).
templ wizardConversation(sessionID, placeholder, prefill string, msgs []wizard.Message) {
	<div x-data="wizardChat()" class="flex flex-col gap-3">
		<div
			id="wizard-transcript"
			x-init="watch($el)"
			hx-get={ "/create/messages/" + sessionID }
			hx-trigger="sse:turn, every 8s"
			hx-swap="innerHTML"
			class="flex h-[55vh] flex-col gap-3 overflow-y-auto rounded-lg border border-border bg-surface p-4"
		>
			@WizardTranscript(msgs, false, 0)
		</div>
		<form
			hx-post="/create/message"
			hx-target="#wizard-transcript"
			hx-swap="innerHTML"
			hx-on::after-request="this.reset(); this.querySelector('textarea').focus()"
			class="flex flex-col gap-1.5"
		>
			<input type="hidden" name="session" value={ sessionID }/>
			<textarea
				name="text"
				rows="3"
				required
				placeholder={ placeholder }
				x-on:keydown.enter="send($event)"
				class="w-full resize-y rounded-md border border-border-strong bg-surface p-3 text-sm text-fg placeholder:text-muted focus:border-border-strong focus:outline-none"
			></textarea>
			<button type="submit" class="sr-only">Send</button>
			<div class="flex items-center justify-between gap-2">
				if prefill != "" {
					<button
						type="button"
						data-prefill={ prefill }
						x-on:click="insertPrefill($event)"
						class="rounded-md border border-border-strong bg-canvas px-3 py-1.5 text-xs font-medium text-fg transition hover:bg-st-idle-bg"
					>Insert prepared requirement</button>
				} else {
					<span></span>
				}
				<p class="text-right text-xs text-muted">
					<kbd class="rounded border border-border px-1 py-0.5 font-mono">Enter</kbd> to send ·
					<kbd class="rounded border border-border px-1 py-0.5 font-mono">Shift</kbd>+<kbd class="rounded border border-border px-1 py-0.5 font-mono">Enter</kbd> inserts a newline
				</p>
			</div>
		</form>
	</div>
}

// WizardTranscript renders the conversation: every finalized message, then a live target
// the in-flight reply streams into. It is embedded in CreatePage for the initial paint and
// returned bare from both GET /create/messages/{session} (the `turn` re-fetch) and POST
// /create/message (so the human's just-sent message appears at once). Because the live
// `delta` target is re-rendered empty on every re-fetch, a completed turn cleanly finalizes
// the streamed reply into a proper bubble and resets the live line for the next turn.
//
// busy reports whether a reply turn is in flight; elapsed is how many seconds it has been
// running (0 when idle), the anchor the activity line ticks up from. While a turn runs, a single
// unified activity line (wizardActivity) names what the planner is doing and shows a live elapsed
// clock — the "it's working, not hung" signal. The first `delta` event streams the reply into
// #wizard-live; the terminal `turn` re-fetch renders with busy=false, clearing the activity line.
templ WizardTranscript(msgs []wizard.Message, busy bool, elapsed int) {
	if len(msgs) == 0 {
		<p class="text-sm text-muted">No messages yet — say what you'd like built to begin.</p>
	} else {
		for _, m := range msgs {
			@wizardBubble(m)
		}
	}
	// The streaming target: assistant `delta` events replace its content as the reply is
	// generated. Whitespace-pre-wrap preserves the model's line breaks while it streams. It sits
	// above the activity line so the streamed prose reads as the planner's reply, with the status
	// pinned beneath it; the `turn` re-fetch finalizes the prose into a bubble and empties this.
	<div id="wizard-live" sse-swap="delta" class="whitespace-pre-wrap text-sm leading-relaxed text-fg"></div>
	// The unified activity line, shown only while a turn is in flight (T4.28 + feedback): three
	// pulsing dots (the "alive" cue), a phase label, and a client-ticked elapsed clock. The label
	// defaults to "Thinking…" and is overwritten by `tool` SSE events as the planner provisions
	// its sandbox ("preparing the codebase sandbox…") or reads code ("read_file foo.go · 3 read"),
	// so one line always says what is happening now. The terminal `turn` re-fetch renders
	// busy=false, so the whole line disappears exactly when the turn concludes.
	if busy {
		@wizardActivity(elapsed)
	}
}

// wizardActivity is the live "the planner is working" line: pulsing dots, a phase label fed by
// `tool` SSE events (defaulting to "Thinking…"), and an elapsed timer the browser ticks from the
// server-provided elapsed anchor (wizardElapsed in wizard.js) so a slow turn visibly counts up
// without the server re-rendering each second. The #wizard-explore span is the `tool` swap
// target; its default text shows until the first phase event arrives.
templ wizardActivity(elapsed int) {
	<div class="flex items-center gap-2 rounded-lg bg-canvas px-3 py-2.5 text-xs text-muted" role="status" aria-label="The requirements planner is working">
		<span class="flex items-center gap-1.5">
			<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-muted"></span>
			<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-muted [animation-delay:200ms]"></span>
			<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-muted [animation-delay:400ms]"></span>
		</span>
		<span id="wizard-explore" sse-swap="tool" class="flex-1 truncate text-fg">Thinking…</span>
		<span
			x-data={ fmt.Sprintf("wizardElapsed(%d)", elapsed) }
			x-text="label"
			class="shrink-0 font-mono tabular-nums text-muted"
		>0:00</span>
	</div>
}

// wizardBubble renders one finalized turn — the human's prompt aligned right, the planner's
// reply left — with whitespace-pre-wrap so the model's formatting (lists, line breaks)
// survives. Text is templ-escaped as inert content; the planner is trusted but its output is
// still model text, never markup.
templ wizardBubble(m wizard.Message) {
	if m.Role == "user" {
		<div class="flex justify-end">
			<div class="max-w-[85%] whitespace-pre-wrap rounded-lg bg-accent-soft px-3 py-2 text-sm text-fg">{ m.Text }</div>
		</div>
	} else {
		<div class="flex justify-start">
			<div class="max-w-[85%] whitespace-pre-wrap rounded-lg bg-canvas px-3 py-2 text-sm text-fg">{ m.Text }</div>
		</div>
	}
}

// LedgerPanel renders the alignment ledger (T4.13/T4.27, specs/control-room.md "The alignment
// ledger") beside the conversation: a lightly-structured snapshot of every fork in one of four
// states (open/agreed/discussing/deferred), each with a one-line rationale and — for an
// answerable fork — selectable option chips, a first-class free-text box, and a "let's discuss"
// flag. The whole panel is ONE batch form: the human resolves any combination of open forks in a
// single submit (T4.27 "forks are surfaced and answered in batches"), funneled back through the
// planner. It is the htmx swap target the page re-fetches on the `ledger` SSE nudge (the planner's
// `update_ledger` tool call) — and ONLY that, plus an `htmx:sseOpen` refetch to recover a nudge
// missed across an SSE reconnect. It deliberately carries NO periodic `every Ns` backstop (T4.33):
// the panel holds the human's in-progress, unsubmitted answers (selected chips, typed free-text),
// and a blind periodic re-render would discard them. Safe because the planner only re-emits the
// ledger at a turn boundary (never during the human's answer window), so the `ledger` nudge covers
// every real change. See specs/control-room.md "Rendering" (the interactive-panel exception) and
// "The alignment ledger". Empty, it shows a muted invitation rather than nothing, so the panel
// reads as a deliberate surface from the first paint.
templ LedgerPanel(session string, items []wizard.LedgerItem) {
	if len(items) == 0 {
		<div class="rounded-lg border border-border bg-surface p-4 text-sm text-muted">
			Alignment ledger — decisions appear here as you converge.
		</div>
	} else {
		<form
			hx-post="/create/ledger/answer"
			hx-target="#wizard-transcript"
			hx-swap="innerHTML"
			class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4"
		>
			<input type="hidden" name="session" value={ session }/>
			<h2 class="text-sm font-semibold tracking-tight text-fg">Alignment ledger</h2>
			<ul class="flex flex-col gap-3">
				for i, it := range items {
					@ledgerRow(i, it)
				}
			</ul>
			if anyAnswerable(items) {
				<div class="flex justify-end border-t border-border pt-3">
					<button
						type="submit"
						class="rounded-md bg-accent-strong px-4 py-2 text-sm font-medium text-white transition hover:bg-accent"
					>Submit answers</button>
				</div>
			}
		</form>
	}
}

// ledgerRow renders one ledger item: a status badge (one of the four states), the question, an
// optional muted one-line rationale, and — when the fork is still answerable (open/discussing) —
// the per-fork answer controls (chips + free text + "let's discuss"). A terminal item
// (agreed/deferred) shows its chosen option read-only instead. The question is templ-escaped as
// inert model text.
templ ledgerRow(idx int, it wizard.LedgerItem) {
	<li class="flex flex-col gap-1.5">
		<div class="flex items-start gap-2">
			<span class={ ledgerStatusClass(it.Status) }>{ it.Status }</span>
			<span class="text-sm text-fg">{ it.Question }</span>
		</div>
		if it.Rationale != "" {
			<p class="pl-1 text-xs text-muted">{ it.Rationale }</p>
		}
		if it.Answerable() {
			@ledgerForkControls(idx, it)
		} else if sel := selectedLabel(it); sel != "" {
			<p class="pl-1 text-xs text-fg">Chosen: <span class="font-medium">{ sel }</span></p>
		}
	</li>
}

// ledgerForkControls renders the three first-class moves on an answerable fork (T4.27): a
// flex-wrap row of option chips (radio inputs styled as pills, named opt-<idx> so one wins per
// fork), a free-text box (named text-<idx> — folding in nuance the canned options missed, which
// the spec makes first-class on *every* fork, not just a fallback), and a "let's discuss"
// checkbox + optional note (discuss-<idx>/note-<idx>) that asks the planner to go deeper. A hidden
// q-<idx> carries the fork's QUESTION: that — not the render index idx — is the identity the
// answer handler re-resolves against the latest ledger, so a ledger re-emitted (reordered or
// shortened) between render and submit never mis-attributes or drops an answer. All inputs live
// inside the panel's single batch form.
templ ledgerForkControls(idx int, it wizard.LedgerItem) {
	<div class="flex flex-col gap-2 pt-0.5">
		<input type="hidden" name={ fmt.Sprintf("q-%d", idx) } value={ it.Question }/>
		if len(it.Options) > 0 {
			<div class="flex flex-wrap gap-2">
				for j, opt := range it.Options {
					@ledgerChip(idx, j, opt)
				}
			</div>
		}
		<input
			type="text"
			name={ fmt.Sprintf("text-%d", idx) }
			placeholder="…or type your own answer"
			class="w-full rounded-md border border-border-strong bg-canvas px-3 py-1.5 text-xs text-fg placeholder:text-muted focus:border-border-strong focus:outline-none"
		/>
		<label class="flex flex-wrap items-center gap-2 text-xs text-muted">
			<span class="inline-flex items-center gap-1.5">
				<input type="checkbox" name={ fmt.Sprintf("discuss-%d", idx) } value="1" class="accent-st-progress"/>
				Let's discuss
			</span>
			<input
				type="text"
				name={ fmt.Sprintf("note-%d", idx) }
				placeholder="what gives you pause? (optional)"
				class="min-w-48 flex-1 rounded-md border border-border bg-canvas px-2 py-1 text-xs text-fg placeholder:text-muted focus:outline-none"
			/>
		</label>
	</div>
}

// ledgerChip renders one fork option as a radio input styled as a selectable pill, inside the
// panel's batch form. The radios for a fork share the name opt-<itemIdx>, so at most one is
// chosen; the planner's current `selected` pre-checks the active one. Selecting a chip and
// pressing Submit funnels the choice through the planner (which re-emits the ledger reflecting
// it). The tradeoff rides in the title (hover) and as a small muted suffix.
templ ledgerChip(itemIdx, optIdx int, opt wizard.LedgerOption) {
	<label class={ chipClass(opt.Selected) } title={ opt.Tradeoff }>
		<input
			type="radio"
			name={ fmt.Sprintf("opt-%d", itemIdx) }
			value={ fmt.Sprintf("%d", optIdx) }
			checked?={ opt.Selected }
			class="accent-st-ok"
		/>
		{ opt.Label }
		if opt.Tradeoff != "" {
			<span class="text-xs opacity-70">— { opt.Tradeoff }</span>
		}
	</label>
}

// anyAnswerable reports whether at least one fork still invites input — the Submit button is
// shown only then (a fully-converged ledger has nothing to submit). Kept in this .templ so it
// compiles alongside the components that call it.
func anyAnswerable(items []wizard.LedgerItem) bool {
	for _, it := range items {
		if it.Answerable() {
			return true
		}
	}
	return false
}

// selectedLabel returns the label of a terminal fork's chosen option (empty if none was
// selected, e.g. a non-fork settled point), so a read-only agreed/deferred row can show what
// was picked.
func selectedLabel(it wizard.LedgerItem) string {
	for _, o := range it.Options {
		if o.Selected {
			return o.Label
		}
	}
	return ""
}

// chipClass returns the Tailwind classes for an option chip (a radio styled as a pill): a
// selected (chosen) chip gets an emerald tint matching the agreed palette; an unselected one is a
// neutral slate pill that brightens on hover. Kept inside this .templ file so the class literals
// are scanned by the Tailwind @source pass (literals in hand-written views/*.go are NOT scanned).
func chipClass(selected bool) string {
	base := "inline-flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1 text-xs transition focus:outline-none "
	if selected {
		return base + "border-st-ok/40 bg-st-ok-bg text-st-ok"
	}
	return base + "border-border-strong bg-canvas text-fg hover:border-border-strong hover:bg-st-idle-bg"
}

// ledgerStatusClass returns the Tailwind classes for the status badge over the four states
// (T4.27): agreed → emerald, open → amber, discussing → a sky "needs you" tint (it gates
// approval, so it stands out), deferred → muted slate (knowingly set aside). Lives here (not in a
// views/*.go file) so the literals reach the Tailwind scan.
func ledgerStatusClass(status string) string {
	base := "shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide "
	switch status {
	case "agreed":
		return base + "bg-st-ok-bg text-st-ok"
	case "discussing":
		return base + "bg-st-progress-bg text-st-progress"
	case "deferred":
		return base + "bg-st-idle-bg text-st-idle"
	default: // open
		return base + "bg-st-warn-bg text-st-warn"
	}
}

// DraftPanel renders the drafted spec + seed issues the planner proposes (T4.14,
// specs/control-room.md "The wizard") and the APPROVE button — the consent boundary. It is the
// htmx swap target the page re-fetches on the `draft` SSE nudge (the planner's `propose_draft`
// tool call) — and ONLY that, plus an `htmx:sseOpen` refetch to recover a nudge missed across an
// SSE reconnect. It carries NO periodic `every Ns` backstop (T4.33): the proposed spec diffs render
// in expandable `<details>`, and a blind periodic re-render would snap shut a panel the human is
// mid-read (and is pointless until the planner re-emits a draft, which only happens at a turn
// boundary). Empty (the planner has not drafted anything yet) it shows a muted invitation, so
// the surface reads as deliberate from the first paint. When canApprove is false (a standalone
// serve with no repo to write) the draft is shown read-only with a note instead of a dead
// button. The proposed spec content is templ-escaped as inert text — it is the trusted planner's
// output but still model-authored markdown, never rendered as markup.
templ DraftPanel(session string, draft wizard.Draft, specs []wizard.SpecFileDiff, canApprove bool) {
	if draft.Empty() {
		<div class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-4 text-sm text-muted">
			<p>
				Drafted spec &amp; seed issues — these appear here, with an Approve button, once the
				planner proposes them. If you're happy with the discussion, ask it to draft now.
			</p>
			// Nudge the planner to draft (T4.14): the Approve gate only appears once the planner
			// emits a ```draft block, and the model may not do so on its own. This funnels a canned
			// "I'm ready — draft it" message through the same /create/message path as a typed reply,
			// so the planner stays the single source of truth; its next turn proposes the draft.
			<form
				hx-post="/create/message"
				hx-target="#wizard-transcript"
				hx-swap="innerHTML"
				class="flex justify-end"
			>
				<input type="hidden" name="session" value={ session }/>
				<input
					type="hidden"
					name="text"
					value="I'm happy with where this has landed — please draft the spec and seed issues now so I can review and approve."
				/>
				<button
					type="submit"
					class="rounded-md bg-accent-strong px-3 py-1.5 text-xs font-medium text-white transition hover:bg-accent"
				>I'm ready — draft the spec</button>
			</form>
		</div>
	} else {
		<div class="flex flex-col gap-4 rounded-lg border border-st-ok/40 bg-surface p-4">
			<div class="flex flex-col gap-1">
				<h2 class="text-sm font-semibold tracking-tight text-fg">Proposed change</h2>
				if draft.Summary != "" {
					<p class="text-sm text-fg">{ draft.Summary }</p>
				}
			</div>
			@draftSpecFiles(specs)
			if len(draft.Issues) > 0 {
				<div class="flex flex-col gap-2">
					<h3 class="text-xs font-medium uppercase tracking-wide text-muted">Seed issues</h3>
					<ul class="flex flex-col gap-2">
						for _, is := range draft.Issues {
							@draftIssueRow(is)
						}
					</ul>
				</div>
			}
			if canApprove {
				// The consent commit is one-shot and not idempotent (commit + seed), so the form
				// guards the double-click on the client too: hx-disabled-elt disables the button
				// for the in-flight request and hx-sync drops a duplicate submit while one is in
				// flight. The .htmx-indicator "Seeding…" line gives an immediate pending state
				// (not an optimistic success — the swapped-in fragment shows the real outcome). The
				// server-side BeginCommit guard is the durable backstop (survives reload / two tabs).
				<form
					hx-post="/create/approve"
					hx-target="#wizard-result"
					hx-swap="innerHTML"
					hx-disabled-elt="find button"
					hx-sync="this:drop"
					class="flex flex-col gap-2 border-t border-border pt-3"
				>
					<input type="hidden" name="session" value={ session }/>
					<p class="text-xs text-st-warn">
						Approving commits the spec to git, writes the decisions record, stores this
						conversation, and creates the seed issues. This is the consent boundary —
						everything after it is autonomous.
					</p>
					<div class="flex items-center justify-end gap-3">
						<span class="htmx-indicator text-xs text-muted">Seeding…</span>
						<button
							type="submit"
							class="rounded-md bg-st-ok px-4 py-2 text-sm font-medium text-white transition hover:bg-st-ok disabled:cursor-not-allowed disabled:opacity-60"
						>Approve &amp; seed</button>
					</div>
				</form>
			} else {
				<p class="border-t border-border pt-3 text-xs text-muted">
					Approval is unavailable here — run the wizard under <code>harness run --serve-addr</code> to commit specs and seed issues.
				</p>
			}
		</div>
	}
}

// draftSpecFiles renders the proposed/refined spec files as collapsible panels — the content the
// consent gate would write. Extracted so both the Create draft panel and the Resolve panel
// (T4.15) render spec edits identically (single source). A brand-new file (IsNew) shows its full
// proposed content; an edit shows a line diff against the file currently on disk (T4.32a), so the
// operator sees *what changed* rather than re-reading the whole file. All text is templ-escaped as
// inert text: trusted planner output, but still model-authored markdown, never rendered as markup.
// The diff tint classes (st-ok/st-blocked) live here, not in a Go helper, because the Tailwind
// @source scanner only reads *.templ + generated *_templ.go.
templ draftSpecFiles(files []wizard.SpecFileDiff) {
	if len(files) > 0 {
		<div class="flex flex-col gap-2">
			<h3 class="text-xs font-medium uppercase tracking-wide text-muted">Spec files</h3>
			for _, f := range files {
				<details class="rounded-md border border-border bg-canvas">
					<summary class="cursor-pointer px-3 py-2 text-sm text-fg">
						{ f.Path }
						if f.IsNew {
							<span class="ml-2 rounded bg-st-ok-bg px-1.5 py-0.5 text-xs text-st-ok">new file</span>
						} else {
							<span class="ml-2 rounded bg-st-idle-bg px-1.5 py-0.5 text-xs text-st-idle">edit</span>
						}
					</summary>
					if f.IsNew {
						<pre class="overflow-x-auto whitespace-pre-wrap border-t border-border px-3 py-2 text-xs leading-relaxed text-fg">{ f.Content }</pre>
					} else {
						@specDiff(f.Diff)
					}
				</details>
			}
		</div>
	}
}

// specDiff renders a line diff of an edited spec: added lines tinted emerald, removed lines rose,
// unchanged lines muted, each with a +/-/space gutter so the change is legible without relying on
// color alone. Lines are individual blocks (not one <pre>) so each carries its own tint; whitespace
// is preserved per line (T4.32a).
templ specDiff(lines []wizard.DiffLine) {
	<div class="overflow-x-auto border-t border-border font-mono text-xs leading-relaxed">
		for _, ln := range lines {
			switch ln.Kind {
				case wizard.DiffAdd:
					<div class="whitespace-pre-wrap bg-st-ok-bg px-3 text-st-ok">{ "+ " + ln.Text }</div>
				case wizard.DiffDel:
					<div class="whitespace-pre-wrap bg-st-blocked-bg px-3 text-st-blocked">{ "- " + ln.Text }</div>
				default:
					<div class="whitespace-pre-wrap px-3 text-muted">{ "  " + ln.Text }</div>
			}
		}
	</div>
}

// draftIssueRow renders one proposed seed issue: its title, the role it will enter the pipeline
// at (defaulting note left to the planner), and the spec file it is governed by. Title/body are
// inert escaped text.
templ draftIssueRow(is wizard.DraftIssue) {
	<li class="flex flex-col gap-1 rounded-md border border-border bg-canvas px-3 py-2">
		<div class="flex flex-wrap items-center gap-2">
			<span class="text-sm font-medium text-fg">{ is.Title }</span>
			if is.Role != "" {
				<span class="rounded-full bg-canvas px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-fg">{ is.Role }</span>
			}
		</div>
		if is.Spec != "" {
			<span class="text-xs text-muted">{ is.Spec }</span>
		}
		if is.Body != "" {
			<p class="whitespace-pre-wrap text-xs text-muted">{ is.Body }</p>
		}
	</li>
}

// CreateApproveResult renders the outcome of an APPROVE (T4.14): on success the spec commit and
// the created seed issues (each linking to its detail page), or — when err is non-empty — the
// failure reason (a validation error, a git/beads fault, or the not-attached notice). It is the
// fragment swapped into #wizard-result by the approve form.
templ CreateApproveResult(res wizard.SeedResult, err string) {
	if err != "" {
		<div class="rounded-lg border border-st-blocked/30 bg-st-blocked-bg p-4 text-sm text-st-blocked">
			{ err }
		</div>
	} else {
		<div class="flex flex-col gap-2 rounded-lg border border-st-ok/40 bg-st-ok-bg p-4">
			<h2 class="text-sm font-semibold tracking-tight text-st-ok">Approved — work seeded</h2>
			<p class="text-xs text-muted">
				Committed
				if res.Commit != "" {
					as <code>{ shortHash(res.Commit) }</code>
				}
				. The factory will pick up the seed issues from here.
			</p>
			if len(res.Issues) > 0 {
				<ul class="flex flex-col gap-1">
					for _, is := range res.Issues {
						<li class="text-sm">
							<a href={ templ.URL("/issue/" + is.ID) } class="text-accent hover:text-accent-strong">{ is.ID }</a>
							<span class="text-fg">{ " " + is.Title }</span>
							if is.Role != "" {
								<span class="text-xs text-muted">{ " (" + is.Role + ")" }</span>
							}
						</li>
					}
				</ul>
			}
		</div>
	}
}

// CreateMessage renders the wizard chrome with a single notice instead of the conversation —
// shown when no requirements planner is wired (a standalone `harness serve`, or a config that
// omits the requirements_planner block), so the action surface degrades to an explanation
// rather than a dead form.
templ CreateMessage(msg string) {
	@Layout("Harness — Create Task", "create") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Create Task</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
