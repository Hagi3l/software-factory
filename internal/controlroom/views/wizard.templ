package views

import (
	"fmt"

	"github.com/Loxstomper/harness/internal/controlroom/wizard"
)

// CreatePage is the Create-Task wizard (specs/control-room.md "The wizard"): a steered
// conversation with the trusted, non-sandboxed requirements planner that converges on
// testable intent. It is the human's primary action surface — the one place intent is
// authored before autonomous work is seeded.
//
// It is server-rendered and made live with the same SSE substrate the other views use, but
// in a richer two-channel form because this *is* a streaming conversation: the transcript
// container re-fetches the finalized messages on a `turn` nudge (the server-render-a-fragment
// pattern), while the planner's reply streams token-by-token into a live target via `delta`
// events as it is generated. Both bindings sit inside one SSE-connected element scoped to
// this session, so one human's stream never reaches another.
//
// The wizard is the full Create-Task flow: the conversation loop (T4.12), the live alignment
// ledger (T4.13), and the draft + APPROVE consent gate (T4.14). The draft panel shows the spec
// markdown and seed issues the planner proposes; APPROVE is the consent boundary — only then is
// the spec committed to git, the decisions sidecar written, the transcript stored, and the seed
// issues created through the single-writer path. Everything past APPROVE is autonomous.
templ CreatePage(sessionID string, msgs []wizard.Message) {
	@Layout("Harness — Create Task", "create") {
		<div class="mx-auto flex max-w-3xl flex-col gap-4">
			<div>
				<h1 class="text-xl font-semibold tracking-tight">Create Task</h1>
				<p class="mt-1 text-sm text-slate-400">
					A steered conversation with the requirements planner. Describe what you want
					built; it will probe for examples, edge cases, what to reject, and what is out
					of scope — converging on testable intent. Nothing is written until you approve.
				</p>
			</div>
			<div hx-ext="sse" sse-connect={ "/create/stream/" + sessionID } class="flex flex-col gap-3">
				<div
					id="wizard-ledger"
					hx-get={ "/create/ledger/" + sessionID }
					hx-trigger="sse:ledger, sse:turn, every 8s"
					hx-swap="innerHTML"
				>
					@LedgerPanel(sessionID, nil)
				</div>
				<div
					id="wizard-draft"
					hx-get={ "/create/draft/" + sessionID }
					hx-trigger="sse:draft, sse:turn, every 8s"
					hx-swap="innerHTML"
				>
					@DraftPanel(sessionID, wizard.Draft{}, true)
				</div>
				<div id="wizard-result"></div>
				<div
					id="wizard-transcript"
					hx-get={ "/create/messages/" + sessionID }
					hx-trigger="sse:turn, every 8s"
					hx-swap="innerHTML"
					class="flex min-h-64 flex-col gap-3 rounded-lg border border-slate-800 bg-slate-900/40 p-4"
				>
					@WizardTranscript(msgs)
				</div>
				<form
					hx-post="/create/message"
					hx-target="#wizard-transcript"
					hx-swap="innerHTML"
					hx-on::after-request="this.reset()"
					class="flex flex-col gap-2"
				>
					<input type="hidden" name="session" value={ sessionID }/>
					<textarea
						name="text"
						rows="3"
						required
						placeholder="Describe the change you want, or answer the planner's question…"
						class="w-full resize-y rounded-md border border-slate-700 bg-slate-900 p-3 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-500 focus:outline-none"
					></textarea>
					<div class="flex justify-end">
						<button
							type="submit"
							class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-500"
						>Send</button>
					</div>
				</form>
			</div>
		</div>
	}
}

// WizardTranscript renders the conversation: every finalized message, then a live target
// the in-flight reply streams into. It is embedded in CreatePage for the initial paint and
// returned bare from both GET /create/messages/{session} (the `turn` re-fetch) and POST
// /create/message (so the human's just-sent message appears at once). Because the live
// `delta` target is re-rendered empty on every re-fetch, a completed turn cleanly finalizes
// the streamed reply into a proper bubble and resets the live line for the next turn.
templ WizardTranscript(msgs []wizard.Message) {
	if len(msgs) == 0 {
		<p class="text-sm text-slate-500">No messages yet — say what you'd like built to begin.</p>
	} else {
		for _, m := range msgs {
			@wizardBubble(m)
		}
	}
	// The streaming target: assistant `delta` events replace its content as the reply is
	// generated. Empty (between turns) it renders nothing; whitespace-pre-wrap preserves the
	// model's line breaks while it streams.
	<div id="wizard-live" sse-swap="delta" class="whitespace-pre-wrap text-sm leading-relaxed text-slate-300"></div>
}

// wizardBubble renders one finalized turn — the human's prompt aligned right, the planner's
// reply left — with whitespace-pre-wrap so the model's formatting (lists, line breaks)
// survives. Text is templ-escaped as inert content; the planner is trusted but its output is
// still model text, never markup.
templ wizardBubble(m wizard.Message) {
	if m.Role == "user" {
		<div class="flex justify-end">
			<div class="max-w-[85%] whitespace-pre-wrap rounded-lg bg-indigo-600/30 px-3 py-2 text-sm text-slate-100">{ m.Text }</div>
		</div>
	} else {
		<div class="flex justify-start">
			<div class="max-w-[85%] whitespace-pre-wrap rounded-lg bg-slate-800/70 px-3 py-2 text-sm text-slate-200">{ m.Text }</div>
		</div>
	}
}

// LedgerPanel renders the alignment ledger (T4.13, specs/control-room.md "The alignment
// ledger") beside the conversation: a lightly-structured snapshot of what is agreed and what
// is still open, each with a one-line rationale, and — for an unsettled fork — selectable
// option chips. It is the htmx swap target the page re-fetches on a `ledger`/`turn` SSE nudge
// (with a slow periodic backstop). Empty, it shows a muted invitation rather than nothing, so
// the panel reads as a deliberate surface from the first paint.
templ LedgerPanel(session string, items []wizard.LedgerItem) {
	if len(items) == 0 {
		<div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4 text-sm text-slate-500">
			Alignment ledger — decisions appear here as you converge.
		</div>
	} else {
		<div class="flex flex-col gap-3 rounded-lg border border-slate-800 bg-slate-900/40 p-4">
			<h2 class="text-sm font-semibold tracking-tight text-slate-200">Alignment ledger</h2>
			<ul class="flex flex-col gap-3">
				for i, it := range items {
					@ledgerRow(session, i, it)
				}
			</ul>
		</div>
	}
}

// ledgerRow renders one ledger item: a status badge (agreed/open), the question, an optional
// muted one-line rationale, and — when the point is an unsettled fork — a flex-wrap row of
// selectable option chips. The question is templ-escaped as inert model text.
templ ledgerRow(session string, idx int, it wizard.LedgerItem) {
	<li class="flex flex-col gap-1.5">
		<div class="flex items-start gap-2">
			<span class={ ledgerStatusClass(it.Status) }>{ it.Status }</span>
			<span class="text-sm text-slate-200">{ it.Question }</span>
		</div>
		if it.Rationale != "" {
			<p class="pl-1 text-xs text-slate-500">{ it.Rationale }</p>
		}
		if len(it.Options) > 0 {
			<div class="flex flex-wrap gap-2 pt-0.5">
				for j, opt := range it.Options {
					@ledgerChip(session, idx, j, opt)
				}
			</div>
		}
	</li>
}

// ledgerChip renders one fork option as a clickable button. Clicking POSTs the choice to
// /create/ledger/select, which funnels it through the planner (re-emitting the ledger) and
// returns the transcript fragment swapped into #wizard-transcript so the human's choice
// appears at once; the refreshed ledger arrives over the `ledger` SSE nudge. The tradeoff
// rides in the title (hover) and as a small muted suffix. htmx serializes hx-vals as form
// fields, matching the POST handler's FormValue reads.
templ ledgerChip(session string, itemIdx, optIdx int, opt wizard.LedgerOption) {
	<button
		type="button"
		hx-post="/create/ledger/select"
		hx-vals={ ledgerVals(session, itemIdx, optIdx) }
		hx-target="#wizard-transcript"
		hx-swap="innerHTML"
		title={ opt.Tradeoff }
		class={ chipClass(opt.Selected) }
	>
		{ opt.Label }
		if opt.Tradeoff != "" {
			<span class="text-xs opacity-70">— { opt.Tradeoff }</span>
		}
	</button>
}

// ledgerVals builds the hx-vals JSON htmx posts as form fields for a chip click: the session
// id plus the item/option indices the select handler resolves against the latest ledger.
func ledgerVals(session string, itemIdx, optIdx int) string {
	return fmt.Sprintf("{\"session\":%q,\"item\":%d,\"option\":%d}", session, itemIdx, optIdx)
}

// chipClass returns the Tailwind classes for an option chip: a selected (chosen) chip gets an
// emerald tint matching the agreed palette; an unselected one is a neutral slate pill that
// brightens on hover. Kept inside this .templ file so the class literals are scanned by the
// Tailwind @source pass (literals in hand-written views/*.go are NOT scanned).
func chipClass(selected bool) string {
	base := "rounded-full border px-3 py-1 text-xs transition focus:outline-none "
	if selected {
		return base + "border-emerald-500/40 bg-emerald-500/20 text-emerald-200"
	}
	return base + "border-slate-700 bg-slate-800/70 text-slate-200 hover:border-slate-500 hover:bg-slate-700/70"
}

// ledgerStatusClass returns the Tailwind classes for the status badge: agreed → emerald tint,
// open → amber. Lives here (not in a views/*.go file) so the literals reach the Tailwind scan.
func ledgerStatusClass(status string) string {
	base := "shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide "
	if status == "agreed" {
		return base + "bg-emerald-500/20 text-emerald-300"
	}
	return base + "bg-amber-500/20 text-amber-300"
}

// DraftPanel renders the drafted spec + seed issues the planner proposes (T4.14,
// specs/control-room.md "The wizard") and the APPROVE button — the consent boundary. It is the
// htmx swap target the page re-fetches on a `draft`/`turn` SSE nudge (with a slow periodic
// backstop). Empty (the planner has not drafted anything yet) it shows a muted invitation, so
// the surface reads as deliberate from the first paint. When canApprove is false (a standalone
// serve with no repo to write) the draft is shown read-only with a note instead of a dead
// button. The proposed spec content is templ-escaped as inert text — it is the trusted planner's
// output but still model-authored markdown, never rendered as markup.
templ DraftPanel(session string, draft wizard.Draft, canApprove bool) {
	if draft.Empty() {
		<div class="rounded-lg border border-slate-800 bg-slate-900/40 p-4 text-sm text-slate-500">
			Drafted spec &amp; seed issues — these appear here, with an Approve button, once the
			planner has converged enough to propose them.
		</div>
	} else {
		<div class="flex flex-col gap-4 rounded-lg border border-emerald-900/40 bg-slate-900/40 p-4">
			<div class="flex flex-col gap-1">
				<h2 class="text-sm font-semibold tracking-tight text-slate-200">Proposed change</h2>
				if draft.Summary != "" {
					<p class="text-sm text-slate-300">{ draft.Summary }</p>
				}
			</div>
			@draftSpecFiles(draft.Specs)
			if len(draft.Issues) > 0 {
				<div class="flex flex-col gap-2">
					<h3 class="text-xs font-medium uppercase tracking-wide text-slate-400">Seed issues</h3>
					<ul class="flex flex-col gap-2">
						for _, is := range draft.Issues {
							@draftIssueRow(is)
						}
					</ul>
				</div>
			}
			if canApprove {
				<form
					hx-post="/create/approve"
					hx-target="#wizard-result"
					hx-swap="innerHTML"
					class="flex flex-col gap-2 border-t border-slate-800 pt-3"
				>
					<input type="hidden" name="session" value={ session }/>
					<p class="text-xs text-amber-300/90">
						Approving commits the spec to git, writes the decisions record, stores this
						conversation, and creates the seed issues. This is the consent boundary —
						everything after it is autonomous.
					</p>
					<div class="flex justify-end">
						<button
							type="submit"
							class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-500"
						>Approve &amp; seed</button>
					</div>
				</form>
			} else {
				<p class="border-t border-slate-800 pt-3 text-xs text-slate-500">
					Approval is unavailable here — run the wizard under <code>harness run --serve-addr</code> to commit specs and seed issues.
				</p>
			}
		</div>
	}
}

// draftSpecFiles renders the proposed/refined spec markdown as collapsible files — the content
// the consent gate would write. Extracted so both the Create draft panel and the Resolve panel
// (T4.15) render spec edits identically (single source). The content is templ-escaped as inert
// text: trusted planner output, but still model-authored markdown, never rendered as markup.
templ draftSpecFiles(specs []wizard.DraftSpec) {
	if len(specs) > 0 {
		<div class="flex flex-col gap-2">
			<h3 class="text-xs font-medium uppercase tracking-wide text-slate-400">Spec files</h3>
			for _, sp := range specs {
				<details class="rounded-md border border-slate-800 bg-slate-950/40">
					<summary class="cursor-pointer px-3 py-2 text-sm text-slate-200">{ sp.Path }</summary>
					<pre class="overflow-x-auto whitespace-pre-wrap border-t border-slate-800 px-3 py-2 text-xs leading-relaxed text-slate-300">{ sp.Content }</pre>
				</details>
			}
		</div>
	}
}

// draftIssueRow renders one proposed seed issue: its title, the role it will enter the pipeline
// at (defaulting note left to the planner), and the spec file it is governed by. Title/body are
// inert escaped text.
templ draftIssueRow(is wizard.DraftIssue) {
	<li class="flex flex-col gap-1 rounded-md border border-slate-800 bg-slate-950/40 px-3 py-2">
		<div class="flex flex-wrap items-center gap-2">
			<span class="text-sm font-medium text-slate-200">{ is.Title }</span>
			if is.Role != "" {
				<span class="rounded-full bg-slate-800 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-slate-300">{ is.Role }</span>
			}
		</div>
		if is.Spec != "" {
			<span class="text-xs text-slate-500">{ is.Spec }</span>
		}
		if is.Body != "" {
			<p class="whitespace-pre-wrap text-xs text-slate-400">{ is.Body }</p>
		}
	</li>
}

// CreateApproveResult renders the outcome of an APPROVE (T4.14): on success the spec commit and
// the created seed issues (each linking to its detail page), or — when err is non-empty — the
// failure reason (a validation error, a git/beads fault, or the not-attached notice). It is the
// fragment swapped into #wizard-result by the approve form.
templ CreateApproveResult(res wizard.SeedResult, err string) {
	if err != "" {
		<div class="rounded-lg border border-rose-900/50 bg-rose-950/30 p-4 text-sm text-rose-200">
			{ err }
		</div>
	} else {
		<div class="flex flex-col gap-2 rounded-lg border border-emerald-900/50 bg-emerald-950/20 p-4">
			<h2 class="text-sm font-semibold tracking-tight text-emerald-200">Approved — work seeded</h2>
			<p class="text-xs text-slate-400">
				Committed
				if res.Commit != "" {
					as <code>{ shortHash(res.Commit) }</code>
				}
				. The factory will pick up the seed issues from here.
			</p>
			if len(res.Issues) > 0 {
				<ul class="flex flex-col gap-1">
					for _, is := range res.Issues {
						<li class="text-sm">
							<a href={ templ.URL("/issue/" + is.ID) } class="text-indigo-300 hover:text-indigo-200">{ is.ID }</a>
							<span class="text-slate-300">{ " " + is.Title }</span>
							if is.Role != "" {
								<span class="text-xs text-slate-500">{ " (" + is.Role + ")" }</span>
							}
						</li>
					}
				</ul>
			}
		</div>
	}
}

// CreateMessage renders the wizard chrome with a single notice instead of the conversation —
// shown when no requirements planner is wired (a standalone `harness serve`, or a config that
// omits the requirements_planner block), so the action surface degrades to an explanation
// rather than a dead form.
templ CreateMessage(msg string) {
	@Layout("Harness — Create Task", "create") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Create Task</h1>
			<p class="mt-2 text-slate-400">{ msg }</p>
		</div>
	}
}
