package views

// Home is the landing page for the control room — the human's window into a
// running factory (or a standalone serve for chrome/nav exploration).
templ Home(version string) {
	@Layout("Factory — Control Room", "home") {
		<div class="mx-auto max-w-3xl space-y-6">
			<div>
				<h1 class="text-2xl font-semibold tracking-tight">Control room</h1>
				<p class="mt-1 text-muted">
					The human's read-only window into the factory and the only place to act.
					Build <span class="font-mono text-fg">{ version }</span>.
				</p>
			</div>
			<div class="rounded-lg border border-border bg-surface p-4 space-y-2">
				<p class="text-sm text-fg">
					Live data (board, activity feed, budgets, create-task wizard) attaches when you
					start the factory with
					<span class="font-mono text-xs text-fg">software-factory run --serve-addr 127.0.0.1:8080</span>
					and a target <span class="font-mono text-xs text-fg">--repo</span> that has beads.
				</p>
				<p class="text-sm text-muted">
					Standalone <span class="font-mono text-xs">serve</span> is for the UI chrome only —
					views show a not-attached notice until a run is co-located.
				</p>
			</div>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				for _, item := range NavItems {
					<a href={ templ.SafeURL(item.Href) } class="block rounded-lg border border-border bg-surface p-4 hover:border-border-strong hover:bg-surface">
						<span class="font-medium text-fg">{ item.Label }</span>
						if item.Key == "board" {
							<p class="mt-1 text-xs text-muted">Work columns by role</p>
						}
						if item.Key == "create" {
							<p class="mt-1 text-xs text-muted">Spec wizard + seed issues</p>
						}
						if item.Key == "dlq" {
							<p class="mt-1 text-xs text-muted">Dead-letters &amp; resolve</p>
						}
						if item.Key == "activity" {
							<p class="mt-1 text-xs text-muted">Agent + system feed</p>
						}
					</a>
				}
			</div>
		</div>
	}
}

// Placeholder is retained for rare unfinished destinations; prefer data views.
templ Placeholder(label string, active string) {
	@Layout("Factory — "+label, active) {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-2xl font-semibold tracking-tight">{ label }</h1>
			<p class="mt-2 text-muted">This view is not available in this build.</p>
		</div>
	}
}
