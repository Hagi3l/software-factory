package views

import (
	"strconv"

	"github.com/Loxstomper/harness/internal/controlroom/query"
)

// IssueDetailPage is the issue / invocation detail view (specs/control-room.md, T4.7): the
// single-issue forensic surface that stitches beads (the issue and its brief), git (the
// merge provenance, once the work has landed on main), and the artifact store (the
// evidence — the prompt, the test↔spec traceability map, each passing gate check — every
// one a click-through to its raw content). It is the drill-target the board cards, the
// dead-letter queue, and the provenance view all link into, so it is the keystone of the
// read surface. Unlike the board and the feed it is *not* live: a detail page is a
// forensic snapshot of one issue, so it is plainly server-rendered with no SSE refresh.
templ IssueDetailPage(d query.IssueDetail) {
	@Layout("Harness — "+d.Issue.ID, "") {
		<div class="mx-auto max-w-4xl space-y-6">
			<div class="space-y-2">
				<div class="flex flex-wrap items-center gap-3">
					<span class="font-mono text-sm text-muted">{ d.Issue.ID }</span>
					@statusBadge(d.Issue.Status)
					if d.Merged {
						<span class="rounded bg-st-ok-bg px-1.5 py-0.5 text-xs text-st-ok">merged</span>
					}
				</div>
				<h1 class="text-2xl font-semibold tracking-tight">{ d.Issue.Title }</h1>
				if d.Issue.Status == "blocked" {
					// A blocked issue is dead-lettered and awaits a human. Per the human re-entry
					// invariant the action is to refine the spec, so the detail page offers the
					// Resolve wizard (T4.15) directly — the same launch point as the DLQ — alongside
					// the orchestrator's reason it terminated.
					<a href={ templ.URL("/resolve/" + d.Issue.ID) } class="inline-block rounded bg-st-ok px-2.5 py-1 text-sm font-medium text-white transition hover:bg-st-ok">Resolve this escalation →</a>
					if d.Issue.DeadLetterReason != "" {
						<p class="text-sm text-st-blocked">{ d.Issue.DeadLetterReason }</p>
					}
				}
				<div class="flex flex-wrap items-center gap-4">
					if d.Provenance.Transcript != "" {
						// The decision trail is reachable only once the transcript hash is retained on
						// the merge trailer (T4.7b), so the replay drill-through surfaces only for merged
						// work — exactly where Replay can reconstruct it.
						<a href={ templ.URL("/replay/" + d.Issue.ID) } class="inline-block text-sm text-st-progress hover:text-st-progress hover:underline">▸ Replay decision trail</a>
					}
					if d.Issue.GateVerdict != "" {
						// The trust argument — producer≠verifier souls, red→green, mutation, scanners —
						// reachable for *any* gated candidate (the verdict is stamped on every disposition,
						// T4.22), so this surfaces for rejected work too, not only merged.
						<a href={ templ.URL("/verification/" + d.Issue.ID) } class="inline-block text-sm text-st-progress hover:text-st-progress hover:underline">▸ Verification</a>
					}
				</div>
			</div>
			<section class="space-y-2">
				<h2 class="text-sm font-medium text-muted">Brief</h2>
				<dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
					@field("Role", orDash(d.Issue.Role), false)
					@field("Spec", orDash(d.Issue.Spec), true)
					if d.Issue.SpecHash != "" {
						@field("Spec version", shortHash(d.Issue.SpecHash), true)
					}
					if d.Issue.Base != "" {
						@field("Base", d.Issue.Base, true)
					}
					@field("Attempt", strconv.Itoa(d.Issue.Attempt), false)
					@field("Spend", issueSpend(d.Issue), false)
					if bd := issueTokenBreakdown(d.Issue); bd != "" {
						@field("Tokens", bd, false)
					}
				</dl>
				if d.Issue.Body != "" {
					<pre class="whitespace-pre-wrap break-words rounded-lg border border-border bg-surface p-4 text-sm text-fg">{ d.Issue.Body }</pre>
				}
			</section>
			if d.Merged {
				<section class="space-y-2">
					<h2 class="text-sm font-medium text-muted">Provenance</h2>
					<dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
						@field("Soul", orDash(d.Provenance.Soul), false)
						@field("Model", orDash(d.Provenance.Model), true)
					</dl>
				</section>
			}
			if d.Diff != "" {
				<section class="space-y-2">
					<h2 class="text-sm font-medium text-muted">Candidate diff</h2>
					// The diff is agent-authored output, but templ escapes this text node, so it
					// renders as inert text rather than markup — safe inline (the raw-bytes nosniff
					// contract is for the /artifact endpoint, not this server-rendered page).
					<pre class="overflow-x-auto whitespace-pre rounded-lg border border-border bg-surface p-4 text-xs text-fg">{ d.Diff }</pre>
				</section>
			}
			<section class="space-y-2">
				<h2 class="text-sm font-medium text-muted">Evidence</h2>
				if len(d.Evidence) == 0 {
					<p class="text-sm text-muted">No evidence recorded yet.</p>
				} else {
					<ul class="flex flex-col gap-2">
						for _, e := range d.Evidence {
							@evidenceItem(e)
						}
					</ul>
				}
			</section>
		</div>
	}
}

// field renders one definition-list cell of the detail grid. mono tags the value as a
// machine token (a path, a ref, a hash) so it renders in a monospace face.
templ field(label, value string, mono bool) {
	<div>
		<dt class="text-muted">{ label }</dt>
		if mono {
			<dd class="break-all font-mono text-fg">{ value }</dd>
		} else {
			<dd class="text-fg">{ value }</dd>
		}
	</div>
}

// evidenceItem renders one cited artifact: its human label, its kind, and a link to the
// raw content when the store can resolve it. A check cited with no persisted evidence (a
// bare name in the provenance trailer) still shows — that the check ran is itself signal —
// just without a click-through. The hash is rendered short for legibility; the anchor
// carries the full address.
templ evidenceItem(e query.ArtifactLink) {
	<li class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-border bg-surface px-3 py-2 text-sm">
		<div class="flex items-center gap-3">
			<span class="text-fg">{ e.Label }</span>
			<span class="rounded-full bg-canvas px-2 py-0.5 text-xs text-muted">{ e.Kind }</span>
		</div>
		if e.Available {
			<a
				href={ templ.URL("/artifact/" + e.Hash) }
				target="_blank"
				rel="noopener"
				class="font-mono text-xs text-st-progress hover:text-st-progress hover:underline"
			>{ shortHash(e.Hash) }</a>
		} else if e.Hash != "" {
			<span class="font-mono text-xs text-faint" title="not resolvable in the artifact store">{ shortHash(e.Hash) } · unavailable</span>
		} else {
			<span class="text-xs text-faint">no evidence persisted</span>
		}
	</li>
}

// IssueDetailMessage renders the detail chrome with a single notice instead of an issue —
// used when the control room is not attached to a running factory (a standalone `harness
// serve` has no beads to read) or when the issue cannot be loaded (an unknown id).
templ IssueDetailMessage(msg string) {
	@Layout("Harness — Issue", "") {
		<div class="mx-auto max-w-3xl">
			<h1 class="text-xl font-semibold tracking-tight">Issue</h1>
			<p class="mt-2 text-muted">{ msg }</p>
		</div>
	}
}
