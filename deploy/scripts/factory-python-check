#!/usr/bin/env bash
# factory-python-check — adaptive Python gate driver for the python-toolchain sandbox.
#
# Usage: factory-python-check <test|lint|typecheck|install>
set -euo pipefail

action="${1:-}"
if [[ -z "$action" ]]; then
  echo "factory-python-check: usage: factory-python-check <test|lint|typecheck|install>" >&2
  exit 2
fi

# Prefer project venv if present (host seed or agent-created).
if [[ -x .venv/bin/python ]]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
elif [[ -x venv/bin/python ]]; then
  # shellcheck disable=SC1091
  source venv/bin/activate
fi

case "$action" in
  install)
    if [[ -f pyproject.toml ]] || [[ -f requirements.txt ]] || [[ -f setup.py ]]; then
      if [[ -f pyproject.toml ]] && command -v pip >/dev/null 2>&1; then
        # Editable install with dev extras when declared.
        pip install -e ".[dev]" 2>/dev/null || pip install -e . 2>/dev/null || pip install -r requirements.txt 2>/dev/null || true
      elif [[ -f requirements.txt ]]; then
        pip install -r requirements.txt
      fi
    fi
    ;;
  test)
    factory-python-check install
    if command -v pytest >/dev/null 2>&1; then
      # Prefer package-local pytest config; fall back to discovering tests.
      pytest -q
    elif [[ -f manage.py ]]; then
      python manage.py test
    else
      python -m unittest discover -q
    fi
    ;;
  lint)
    factory-python-check install
    if command -v ruff >/dev/null 2>&1; then
      ruff check .
    elif command -v flake8 >/dev/null 2>&1; then
      flake8 .
    else
      echo "factory-python-check: no ruff/flake8 on PATH" >&2
      exit 1
    fi
    ;;
  typecheck)
    factory-python-check install
    if command -v mypy >/dev/null 2>&1; then
      # mypy may be configured in pyproject; empty projects still exit 0 with no files.
      mypy . --exclude '(\.venv|venv|build|dist)' 2>/dev/null || mypy .
    else
      echo "factory-python-check: mypy not installed; skipping (exit 0)"
      exit 0
    fi
    ;;
  *)
    echo "factory-python-check: unknown action $action" >&2
    exit 2
    ;;
esac
